# Copy to `.env` (repo root for docker compose, or backend/ when running locally).

# LLM provider: gemini | anthropic | fake  (fake = offline, no key needed)
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash          # optional override of the provider default
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: require `X-API-Key` on /api/* routes
# API_KEY=change-me

# Vector store (local dev defaults; docker compose overrides these)
CHROMA_MODE=persistent
CHROMA_PATH=.chroma

RETRIEVAL_TOP_K=6
LOG_LEVEL=INFO
